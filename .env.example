# Production Docker settings. Copy to .env and fill the secrets.
# cp .env.example .env

APP_PORT=80
CLIENT_ORIGIN=http://localhost

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=jaafar_accounting

INVOICE_READER_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Set true only on the first deploy if you want demo data.
# The seed wipes existing accounting data.
SEED_ON_START=false
